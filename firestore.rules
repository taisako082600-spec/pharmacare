rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ヘルパー関数
    function isSignedIn() {
      return request.auth != null;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && getUserData().isAdmin == true;
    }
    function isFacilityAdmin() {
      return isSignedIn() && getUserData().role == 'facility_admin';
    }
    function belongsToFacility(facilityId) {
      return isSignedIn() && (
        getUserData().facilityId == facilityId ||
        facilityId in getUserData().facilityIds
      );
    }

    // 家族ロール判定ヘルパー
    function isLinkedFamily(patientId) {
      return isSignedIn() &&
        getUserData().role == '家族' &&
        getUserData().linkedPatientId == patientId;
    }

    // ユーザー
    // 本人だけが書き換えてはいけないフィールド。
    //
    // isAdmin() は users/{uid}.isAdmin を読んで判定しているため、本人が自分の
    // ドキュメントを自由に更新できると `isAdmin: true` を自分で立てられてしまい、
    // 全施設の患者情報へアクセスできる(2026-08-24の点検で発見)。
    // role / linkedPatientId も同様で、'家族' + 任意の patientId を書けば
    // その患者の情報が読める。mfaRequired は二要素認証の必須化を外せてしまう。
    //
    // いずれもアプリ上で本人が変更する導線は無いので、まとめて禁止する。
    function changesPrivilegedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isAdmin', 'role', 'linkedPatientId', 'mfaRequired']);
    }

    // facilityId / facilityIds は「本人が招待コードで参加するときに書く」ため
    // 上の禁止リストから外していたが、**それ自体が穴だった**(2026-08-27に判明)。
    // 誰でも自分の facilityId を任意の施設IDに書き換えられ、書き換えた瞬間に
    // belongsToFacility() が真になって、その施設の入居者情報が全部読めていた。
    // 招待コードの検証がクライアント側にしか無いことが原因。
    //
    // そこで、施設への所属を変える書き込みは次のどちらかでしか通らないようにする。
    //
    //   1. その施設を自分で作った場合(新規施設の登録フロー)
    //   2. 有効な招待コードを提示した場合
    //
    // 2の検証にはコードの実体を読む必要があるが、**ルール内の get() は
    // read 権限を経由しない**ため、クライアントに読ませないまま照合できる。
    // これを成立させるために invite_codes は「コード文字列そのものを
    // ドキュメントID」にしてある(自動採番IDのままだと get() で引けない)。
    function changesFacilityFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['facilityId', 'facilityIds']);
    }

    function ownsTargetFacility() {
      let fid = request.resource.data.get('facilityId', '');
      return fid != ''
        && exists(/databases/$(database)/documents/facilities/$(fid))
        && get(/databases/$(database)/documents/facilities/$(fid)).data.createdBy == request.auth.uid;
    }

    // 参加に使った招待コードを users ドキュメントの joinedWithCode に書かせ、
    // それが実在し、かつ書き込もうとしている facilityId と一致することを確かめる。
    // 期限切れも弾く。使用済み(used)は、同じバッチ内で使用済みに更新する都合上
    // ここでは見ない(ルールは書き込み前の状態を見るため、正規の参加まで弾いてしまう)。
    function hasValidInviteCode() {
      let code = request.resource.data.get('joinedWithCode', '');
      let fid = request.resource.data.get('facilityId', '');
      return code != ''
        && exists(/databases/$(database)/documents/invite_codes/$(code))
        && get(/databases/$(database)/documents/invite_codes/$(code)).data.facilityId == fid
        && get(/databases/$(database)/documents/invite_codes/$(code)).data.expiresAt > request.time;
    }

    function facilityJoinIsAuthorised() {
      return ownsTargetFacility() || hasValidInviteCode();
    }

    // 施設側が、承認した薬剤師の users ドキュメントへ所属を書き込むための例外。
    //
    // 申請→承認のフローでは、書き込む相手が自分ではない。以前は施設管理者が
    // 直接 users/{薬剤師} を更新しており、ルールはグローバル管理者しか
    // 許可していないため**承認が常に失敗していた**(2026-08-27に判明)。
    //
    // かといって「施設の人なら他人のusersを書ける」にすると、任意の利用者の
    // 所属を勝手に付け替えて、その人を本来の施設から締め出せてしまう。
    // そこで **承認済みの申請が実在すること** を条件にする。申請の
    // ドキュメントIDを「薬剤師UID_施設ID」に固定してあるので get() で辿れる。
    //
    // 書き換えてよいのは所属3項目だけ。role や linkedPatientId には触らせない。
    function grantsApprovedConnection(targetUid) {
      let fid = request.resource.data.get('facilityId', '');
      let requestId = targetUid + '_' + fid;
      return isSignedIn()
        && fid != ''
        && belongsToFacility(fid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['facilityId', 'facilityIds', 'facilityName'])
        && exists(/databases/$(database)/documents/connection_requests/$(requestId))
        && get(/databases/$(database)/documents/connection_requests/$(requestId)).data.status == 'approved';
    }

    // 家族アカウントが「どの入居者に紐づくか」の検証。
    //
    // isLinkedFamily() は users の role=='家族' と linkedPatientId だけで判定している。
    // この2つは作成時に本人が自由に書けるので、**入居者IDを知っていれば、誰でも
    // その入居者の家族として登録し、処方・バイタル・受診記録を読めた**
    // (2026-08-27の独立レビューで発見。changesPrivilegedUserFields() は update 専用の
    // 差分判定なので、新規作成には効いていなかった)。
    //
    // 入居者IDは自動採番の20文字なので総当たりはできないが、URLや画面の共有で
    // 漏れうる値であり、「知られたら終わり」の設計にしてはいけない。
    // 家族用の招待コードには patientId が入っているので、それと一致させる。
    function linkedPatientIsAuthorised() {
      let pid = request.resource.data.get('linkedPatientId', '');
      let code = request.resource.data.get('joinedWithCode', '');
      return pid == ''
        || (code != ''
            && exists(/databases/$(database)/documents/invite_codes/$(code))
            && get(/databases/$(database)/documents/invite_codes/$(code)).data.get('patientId', '') == pid);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      // 作成時に自分を管理者にできないようにする。
      // 施設に所属した状態で作る場合は、その所属が正当であることまで確かめる。
      allow create: if request.auth.uid == uid
                    && request.resource.data.isAdmin == false
                    && (request.resource.data.get('facilityId', '') == ''
                        || facilityJoinIsAuthorised())
                    && linkedPatientIsAuthorised();
      allow update: if isAdmin()
                    || (request.auth.uid == uid
                        && !changesPrivilegedUserFields()
                        && (!changesFacilityFields() || facilityJoinIsAuthorised()))
                    || grantsApprovedConnection(uid);
      allow delete: if isAdmin();
    }

    // 施設
    match /facilities/{facilityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (isFacilityAdmin() && belongsToFacility(facilityId));
      allow delete: if isAdmin();
    }

    // 招待コード
    //
    // ドキュメントIDはコード文字列そのもの。users のルールが get() で照合するため。
    //
    // read を get と list に分けている。
    //
    // get を無条件にしているのは、**登録画面のコード確認がサインイン前に走る**ため。
    // アカウントを作る前に「そのコードがどの施設・どの入居者のものか」を出す必要があり、
    // ここを認証必須にすると新規登録が成立しない。
    //
    // 引き換えに残るのは「コードを総当たりされうる」こと。ただし当たったところで
    // 得られるのは施設名等で、**コードを持っている＝参加を許可されている**という
    // この仕組みの前提そのものなので、権限の面で新たに失うものは無い。
    // 一方 list(クエリ)は施設関係者に限る。開けると総当たりすら不要になるため。
    //
    // **残る弱点はコードが6桁の数字であること**(10^6で探索可能)。
    // 桁数を増やすか英数字にすれば桁違いに強くなる。UIの文言と併せて要検討。
    match /invite_codes/{codeId} {
      allow get: if true;
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.createdBy ||
        belongsToFacility(resource.data.facilityId) ||
        isAdmin()
      );
      // register_screen.dartの新規施設作成フローでは、施設作成 → 自分のusers.facilityId更新 →
      // 招待コード発行、の順で書き込むため、この時点で既に belongsToFacility が真になる。
      // 以前は isFacilityAdmin()(廃止ロール)||isAdmin() のみを許可しており、新規施設作成の
      // 度に招待コード発行が失敗 → register_screen.dartのロールバックで施設ごと削除される
      // という重大な不具合になっていた(2026-07-19に発見・修正)。
      allow create: if isSignedIn() && (
        belongsToFacility(request.resource.data.facilityId) || isFacilityAdmin() || isAdmin()
      );
      // 更新でできることは「自分が使った印を付ける」だけに絞る。
      //
      // 以前は facilityId と code が変わらなければ何でも通ったため、
      //   - 他人のコードを勝手に使用済みにして参加を妨害できた(usedByが誰でもよかった)
      //   - 未使用コードの expiresAt を延ばせた
      //   - **家族用コードの patientId を別の入居者に付け替えられた**
      //     (次にそのコードを使う人が、別の入居者の家族として登録されてしまう)
      // という余地が残っていた(2026-08-27の独立レビューで発見)。
      //
      // hasOnly で変更可能なキーを3つに限定し、usedBy が自分であることまで要求する。
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.used == false &&
          request.resource.data.used == true &&
          request.resource.data.usedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['used', 'usedBy', 'usedAt'])
        )
      );
      allow delete: if isAdmin();
    }

    // 連携申請
    match /connection_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.pharmacistId == request.auth.uid ||
        belongsToFacility(resource.data.facilityId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.pharmacistId == request.auth.uid;
      allow update: if isAdmin() ||
        belongsToFacility(resource.data.facilityId); // 施設管理者が承認/拒否
      allow delete: if isSignedIn() && resource.data.pharmacistId == request.auth.uid; // 申請者が取り消し
    }

    // 患者
    match /patients/{patientId} {
      allow read: if isSignedIn() && (
        belongsToFacility(resource.data.facilityId) || isAdmin() || isLinkedFamily(patientId)
      );
      allow create: if isSignedIn() && (belongsToFacility(request.resource.data.facilityId) || isAdmin());
      allow update: if isSignedIn() && (belongsToFacility(resource.data.facilityId) || isAdmin());
      allow delete: if isAdmin() || (isFacilityAdmin() && belongsToFacility(resource.data.facilityId));

      match /medicines/{medicineId} {
        allow read: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
        ) || isLinkedFamily(patientId) || isAdmin());
        allow write: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
        ) || isAdmin());
      }

      match /vitals/{vitalId} {
        allow read: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
        ) || isLinkedFamily(patientId) || isAdmin());
        allow write: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
        ) || isAdmin());
      }

      match /records/{recordId} {
        allow read, write: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
        ) || isAdmin());
      }

      match /visits/{visitId} {
        allow read: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
        ) || isLinkedFamily(patientId) || isAdmin());
        allow write: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
        ) || isAdmin());

        // 受診ごとの処方薬剤。家族は「自分の家族の処方内容」を見るのが本来の目的なので
        // 参照のみ許可する(ガイドライン システム運用編 7.2.2「患者への情報提供は、
        // 一般的には参照のみとすること」)。パスに patientId が含まれるため、
        // isLinkedFamily で自分に紐付く患者だけに確実に限定できる。
        // ※ここに read 権限が無かったため、家族画面の「現在の処方」で薬剤名が
        //   1件も表示されない状態だった(2026-08-17に発見)。
        match /medicines/{medicineId} {
          allow read: if isSignedIn() && (belongsToFacility(
            get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
          ) || isLinkedFamily(patientId) || isAdmin());
          allow write: if isSignedIn() && (belongsToFacility(
            get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
          ) || isAdmin());

          match /intake_logs/{logId} {
            allow read, write: if isSignedIn() && (belongsToFacility(
              get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
            ) || isAdmin());
          }
        }

        match /side_effect_checks/{checkId} {
          allow read, write: if isSignedIn() && (belongsToFacility(
            get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
          ) || isAdmin());
        }
      }

      // OTCトリアージレコード。otc_triage_form_screen.dart が
      // patients/{patientId}/otc_triage_records に直接書き込むため、
      // visits の下ではなく patients 直下にマッチさせる(実際の書き込みパスと一致させる)。
      match /otc_triage_records/{triageId} {
        allow read: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
        ) || isAdmin());
        allow create: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
        ) || isAdmin());
        allow update: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/patients/$(patientId)).data.facilityId
        ) || isAdmin());
      }
    }

    // side_effect_checks コレクショングループ（患者一覧バッジ用）
    match /{path=**}/side_effect_checks/{checkId} {
      allow read: if isSignedIn() && (belongsToFacility(resource.data.facilityId) || isAdmin());
    }

    // チャット
    // 全ての箇所に || isAdmin() を付けているのは、管理画面の「この施設の画面を確認する」
    // (admin_dashboard_screen.dart)がなりすまし表示であり、Firestoreルールは実際にサインイン
    // している管理者本人のusersドキュメント(facilityId未設定なことが多い)で判定するため。
    // isAdmin()のOR分岐がないと、管理者がこの機能で入った瞬間にほぼ全ての画面でpermission-denied
    // になる(2026-07-19に発見・修正)。
    match /rooms/{roomId} {
      // まだ一度も発言のないルームは、ドキュメント自体が存在しない。
      // その状態で resource.data.facilityId を参照するとルール評価に失敗し、
      // permission-denied になる(チャット一覧で新規入居者のタイルだけが
      // 「Missing or insufficient permissions」になる不具合。2026-08-18に実機で発覚)。
      //
      // ルームIDは "{facilityId}_..." の形式なので、ドキュメントが無い場合は
      // ID の施設部分で判定する。これなら自分の施設のルームに限定できる。
      allow read: if isSignedIn() && (
        isAdmin()
        || (resource != null && belongsToFacility(resource.data.facilityId))
        || (resource == null && belongsToFacility(roomId.split('_')[0]))
      );
      // create/updateを分離: 新規作成時はresourceがまだ存在せずresource.data.facilityIdが
      // 評価できないため、常にfalseになり新規ルーム作成自体が弾かれてしまう不具合があった。
      // createはrequest.resource(書き込み後の状態)で判定する。
      allow create: if isSignedIn() && (belongsToFacility(request.resource.data.facilityId) || isAdmin());
      allow update: if isSignedIn() && (belongsToFacility(resource.data.facilityId) || isAdmin());

      match /messages/{messageId} {
        allow read: if isSignedIn() && (belongsToFacility(
          get(/databases/$(database)/documents/rooms/$(roomId)).data.facilityId
        ) || isAdmin());
        allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid &&
          (belongsToFacility(get(/databases/$(database)/documents/rooms/$(roomId)).data.facilityId) || isAdmin());
        allow update, delete: if false;
      }
    }

    // 監査ログ
    // 「医療情報システムの安全管理に関するガイドライン第7.0版」システム運用編
    // 17.証跡のレビュー・システム監査 に対応する。
    //  - ①アクセスログを記録する → create を許可する(以前は write:false で
    //    全書き込みを禁じていたため、記録処理を書いても1件も残らなかった)
    //  - ②ログの不当な削除／改ざん／追加を防止する → update/delete は誰にも許可しない。
    //    さらに、他人になりすましたログを作れないよう userId を認証済みUIDに固定する
    //  - ③記録に用いる時刻は信頼できる情報を使う → クライアント時刻を受け付けず、
    //    サーバー時刻(request.time = FieldValue.serverTimestamp())と一致するものだけ通す
    match /audit_logs/{logId} {
      // 17①は記録するだけでなく「定期的に確認すること」まで求めており、
      // その確認をするのは**施設**。読み取りが isAdmin() 限定だったため、
      // 施設は自分のところのログを一切見られず、求められていることを
      // 果たせない状態だった。自施設のログに限って開ける。
      // ログには facilityId が入っているので、施設単位に閉じられる。
      allow read: if isAdmin()
                  || (isSignedIn() && belongsToFacility(resource.data.facilityId));
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // 薬剤知識ベース（②医薬品注意点表示 B案）
    // Goプロキシはサービスアカウント(Admin SDK)で直接アクセスするためこれらのルールを経由しない。
    // ここは Flutter クライアント（管理画面での閲覧・手動解決フロー）向けのアクセス制御。

    // 商品名⇔一般名マスタ（薬価基準収載品目リストから定期取り込み）。
    // Goプロキシ(Admin SDK)がこのルールを経由せず読み書きし、Flutter側は現状どの画面からも
    // 参照していないため、isSignedIn()で全ユーザーに公開する必要がない(isAdmin()に限定)。
    match /drug_master/{docId} {
      allow read, write: if isAdmin();
    }

    // 一般名ごとの添付文書ナレッジ（9.2/9.3等のセクション抽出結果）
    match /drug_knowledge_base/{genericName} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // 手動整備(manual_needed解決)含む
    }

    // 名寄せ解決済みキャッシュ（入力文字列→一般名）
    match /drug_name_aliases/{normalizedInput} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 名寄せ未解決キュー（管理者レビュー専用、一般ユーザーには非公開）
    match /unmatched_drug_names/{docId} {
      allow read, write: if isAdmin();
    }

    // 添付文書取得の実需要ログ（名寄せは成功したがdrug_knowledge_baseに
    // エントリが1件もない薬剤。管理者レビュー専用、一般ユーザーには非公開）
    match /drug_fetch_requests/{genericName} {
      allow read, write: if isAdmin();
    }

    // カレンダーイベント
    match /events/{eventId} {
      allow read: if isSignedIn() && (belongsToFacility(resource.data.facilityId) || isAdmin());
      allow create: if isSignedIn() && (belongsToFacility(request.resource.data.facilityId) || isAdmin());
      allow update, delete: if isSignedIn() && (belongsToFacility(resource.data.facilityId) || isAdmin());
    }
  }
}
